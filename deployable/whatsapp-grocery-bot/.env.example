# WhatsApp Cloud API Configuration
# Get these from Meta Developer Portal: https://developers.facebook.com/

# Your WhatsApp Business access token (temporary or permanent)
WHATSAPP_TOKEN=your_whatsapp_access_token_here

# Your WhatsApp Business phone number ID
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Verification token for webhook (create your own random string)
WHATSAPP_VERIFY_TOKEN=your_random_verification_token

# Default location for price lookup (Bengaluru, India)
DEFAULT_LAT=12.9716
DEFAULT_LNG=77.5946
DEFAULT_CITY=Bengaluru
